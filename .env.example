# Copy this file to .env and fill in the values. Never commit .env.

# Neon Postgres connection string (Neon dashboard -> Connect). Use the POOLED string
# (host contains "-pooler") for the running site. Keep ?sslmode=require.
DATABASE_URI=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Long random string used to sign logins. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=change-me

# Public URL of the site (no trailing slash). http://localhost:3000 while developing.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Resend (resend.com -> API Keys). The FROM address must be on a domain verified in Resend.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM_ADDRESS=admissions@jagritiie.com
EMAIL_FROM_NAME=Jagriti Institute of Education

# Where new enquiry / scholarship / admission alerts are sent if none are set in
# Admin -> Site Settings -> Notification emails. Comma-separate several addresses.
ADMIN_NOTIFY_EMAIL=admissions@jagritiie.com
